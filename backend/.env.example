# Environment variables for Lyrics & Chord Detector

# OpenAI API Key (required for fast Whisper transcription)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Chord detection
# CHORD_DETECTION_DEMUCS=auto
# CHORD_DETECTION_DEMUCS_MODEL=mdx
# CHORD_DETECTION_DEMUCS_DEVICE=cpu
# CHORD_DETECTION_DEMUCS_OVERLAP=0.1
# CHORD_DETECTION_DEMUCS_SEGMENT=10
# CHORD_DETECTION_DEMUCS_JOBS=4
# CHORD_DETECTION_DEMUCS_PREFETCH=true
